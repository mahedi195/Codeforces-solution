#include <bits/stdc++.h>
using namespace std;
 
void mahedi_solve_this_prb()
{
    int n;
    cin >> n;
    vector<int> v(n);
    // set<int> s;
    for (int i = 0; i < n; i++)
    {
        cin >> v[i];
    }
 
    int mex = v[n - 1] + 1;
    for (int i = 0; i < n; i++)
    {
        if (i == 0 && v[i] != 0)
        {
            mex = 0;
            break;
            ;
        }
        if (i > 0 && v[i - 1] + 1 != v[i])
        {
            mex = v[i - 1] + 1;
            break;
        }
    }
 
    cout << mex;
    cout << "\n";
 
    int y;
    cin >> y;
 
    if (y == -1)
        return;
 
    while (y != -1)
    {
 
        cout << y<<"\n";
        cin >> y;
    }
}
 
int main()
{
    int t;
    // int t=1;
 
    cin >> t;
    while (t--)
    {
        mahedi_solve_this_prb();
        cout << "\n";
    }
}
