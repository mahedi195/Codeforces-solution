void mahedi_solve_this_prb()
{
    ll n,l,r,k; cin>>n>>l>>r>>k;
 
    if(n%2==1)
    {
        cout<<l;
        return;
    }
 
    ll l1=l;
    int cntDigit=0;
    while(l1>0)
    {
        cntDigit++;
        l1=l1>>1;
 
    }
 
    if(n==2)
    {
        cout<<-1;
        return;
    }
 
    ll x=pow(2,cntDigit);
    //ll x=1LL<<cntDigit;
    if(r<x) cout<<-1;
    else if(k<=n-2) cout<<l;
    else cout<<x;
 
 
}
 
 
