void mahedi_solve_this_prb()
{
    int n;
    cin>>n;
    vector<int>v(n);
    for(int i=0; i<n; i++) cin>>v[i];
 
    vector<int>set_bit_ith_bit(31,0);
    for(int i=0; i<=30; i++)
    {
        int cnt=0;
        for(auto it:v)
        {
            if(((it>>i)&1)==1)
                cnt++;
        }
        set_bit_ith_bit[i]=cnt;
 
    }
 
    // for(auto it:set_bit_ith_bit) cout<<it<<" ";
    //cout<<"\n";
    vector<int>ans;
    for(int k=1; k<=n; k++)
    {
        bool ok=true;
        for(auto it:set_bit_ith_bit)
        {
            if(it%k!=0)
            {
                ok=false;
                break;
            }
 
        }
        if(ok)
            ans.push_back(k);
    }
    for(auto it:ans) cout<<it<<" ";
 
 
 
}
 
 
