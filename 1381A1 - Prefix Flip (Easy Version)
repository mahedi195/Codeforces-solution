#include <bits/stdc++.h>
using namespace std;
using ll=long long;
 
void mahedi_solve_this_prb()
{
    int n;
    cin>>n;
    string a,b;
    cin>>a>>b;
    vector<int>v;
 
 
    for(int i=n-1; i>=0; i--)
    {
        if(a[i]!=b[i])
        {
            if(a[0]==b[i])
            {
                if(a[0]=='0') a[0]='1';
                else if(a[0]=='1') a[0]='0';
                v.push_back(1);
 
                for(int j=0; j<=i; j++)
                {
                    if(a[j]=='0') a[j]='1';
                    else if(a[j]=='1') a[j]='0';
                }
                reverse(a.begin(),a.begin()+i+1);
                v.push_back(i+1);
            }
            else if(a[0]!=b[i])
            {
                for(int j=0; j<=i; j++)
                {
                    if(a[j]=='0') a[j]='1';
                    else if(a[j]=='1') a[j]='0';
                }
                reverse(a.begin(),a.begin()+i+1);
                v.push_back(i+1);
            }
        }
    }
 
    cout<<v.size()<<" ";
    for(auto it:v) cout<<it<<" ";
 
 
 
}
 
 
int main()
{
    int t;
    // int t=1;
 
    cin >> t;
    while (t--)
    {
        mahedi_solve_this_prb();
        cout << "\n\n\n";
    }
}
