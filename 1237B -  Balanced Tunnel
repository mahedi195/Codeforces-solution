void mahedi_solve_this_prb()
{
    int n;
    cin>>n;
    vector<int>entry(n+1);
    for(int i=0; i<n; i++)
    {
        int x;
        cin>>x;
        entry[x]=i;
 
    }
 
    vector<int>entry_mapping(n);
    for(int i=0; i<n; i++)
    {
        int x;
        cin>>x;
        int pos=entry[x];
        entry_mapping[i]=pos;
        // cout<<pos<<" ";
    }
 
    
    int mn=INT_MAX;
    int cnt=0;
    for(int i=n-1; i>=0; i--)
    {
        if(entry_mapping[i]>mn)
            cnt++;
        mn=min(mn,entry_mapping[i]);
    }
 
    cout<<cnt;
 
}
 
 
