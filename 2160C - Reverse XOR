void mahedi_solve_this_prb()
{
    int n;
    cin>>n;
    int n1=n;
 
    if(n1==0)
    {
        cout<<"YES";
        return;
    }
 
    //n1=n;
    int initial_zero=0;
   // cout<<"n1 = "<<n1<<"\n";
    while((n1&1)==0)
        // while(n1>0)
    {
        int x=n1&1;
        // cout<<x<<"  --> \n";
