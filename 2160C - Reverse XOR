    {
        s1+='0';
        initial_zero--;
    }
    s=s1+s;
    //cout<<s<<"\n\n";
 
    int mid=s.size()/2;
    for(int i=0,j=s.size()-1; i<mid; i++,j--)
    {
        if(s[i]!=s[j])
        {
            cout<<"NO";
            return;
        }
    }
 
    if(s.size()%2!=0)
    {
        if(s[mid]=='1')
        {
            cout<<"NO";
            return;
        }
    }
 
    cout<<"YES";
 
 
}
 
 
