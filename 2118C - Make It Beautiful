#include <bits/stdc++.h>
using namespace std;
using  ll=long long;
const double pi = 3.14159265358979323846;
const long long mod = 1e9 + 7;
#define oneMillion 1e6
#define go_mahedi_go ios::sync_with_stdio(false), cin.tie(nullptr)
 
void mahedi_solve_this_prb()
{
    ll n,k;
    cin>>n>>k;
    vector<ll>v(n);
    for(int i=0; i<n; i++) cin>>v[i];
 
    ll ans=0;
    vector<ll>cnt0(61,0);
    for(auto it:v)
    {
        ans+=__builtin_popcountll(it);
        for(int i=0; i<=60; i++)
        {
            if(((it>>i)&1)==0)
                cnt0[i]++;
 
 
        }
    }
 
    for(int i=0;i<=60;i++)
    {
        //ll cost=pow(2,i);
        ll cost=1LL<<i;
        while(cnt0[i]>0 && cost<=k)
        {
            k-=cost;
            ans++;
            cnt0[i]--;
 
            //cost=pow(2,i);
 
        }
 
    }
 
    cout<<ans;
 
 
}
 
 
int main()
{
    //go_mahedi_go;
    int t;
    cin>>t;
    //t=1;
 
 
    while(t--)
    {
        mahedi_solve_this_prb();
        cout<<"\n\n\n";
 
    }
}
 
 
