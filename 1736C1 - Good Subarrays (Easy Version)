void mahedi_solve_this_prb()
{
    int n;
    cin>>n;
    vector<int>v(n+1);
    for(int i=1; i<=n; i++) cin>>v[i];
    int l=1;
    ll ans=0;
    for(int i=1; i<=n; i++)
    {
        l=max(l,i+1-v[i]);
        ans+=i-l+1;
    }
    cout<<ans;
}
 
 
